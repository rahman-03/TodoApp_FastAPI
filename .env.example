# ============================================================================
# FocusSprint FastAPI - Environment Variables Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env file to version control
# ============================================================================

# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL="postgresql://postgres:password@localhost:5432/focussprint"

# ============================================================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================================================
# Generate secure keys using:
# python -c "import secrets; print(secrets.token_hex(32))"

# Access token secret key (used for short-lived tokens)
# Minimum 32 characters - CHANGE THIS IN PRODUCTION
ACCESS_SECRET_KEY="your_super_secret_access_key_with_min_32_chars_here_change_me"

# Refresh token secret key (used for long-lived tokens)
# Minimum 32 characters - CHANGE THIS IN PRODUCTION
REFRESH_SECRET_KEY="your_super_secret_refresh_key_with_min_32_chars_here_change_me"

# JWT Algorithm (usually HS256)
ALGO="HS256"

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# CORS allowed origin - Update with your frontend URL
FRONTEND_URL="http://localhost:4200"

# ============================================================================
# SECURITY NOTES
# ============================================================================
# ⚠️  IMPORTANT - READ BEFORE DEPLOYMENT
# 
# 1. NEVER commit this file to version control
# 2. Generate strong secret keys for production:
#    python -c "import secrets; print(secrets.token_hex(32))"
# 3. Use different secrets for development and production
# 4. Store production secrets in a secure vault (AWS Secrets Manager, etc.)
# 5. Rotate secrets periodically
# 6. Use environment-specific .env files for different deployments
# 
# ============================================================================